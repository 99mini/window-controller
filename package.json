{
  "name": "window-controller",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm run dev:desktop & pnpm run dev:mobile",
